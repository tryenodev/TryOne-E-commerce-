# Environment Variables Template

# Database - Choose one based on your setup:
# Option 1: Docker PostgreSQL (recommended for local development)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/tryeno-one"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/tryeno-one"
# Option 2: Manual/Local PostgreSQL
# DATABASE_URL="postgresql://YOUR_USERNAME:YOUR_PASSWORD@localhost:5432/tryeno-one"
# DIRECT_URL="postgresql://YOUR_USERNAME:YOUR_PASSWORD@localhost:5432/tryeno-one"
# Option 3: Vercel + Neon (production)
# Use pooled URL for app queries; non-pooled for migrations (from Vercel Storage → Neon):
# DATABASE_URL="<POSTGRES_PRISMA_URL from Vercel>"
# DIRECT_URL="<POSTGRES_URL_NON_POOLING from Vercel>"

# NextAuth
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="***********************************"
# Generate secret with: openssl rand -base64 32

# App Environment
NODE_ENV="development"
PORT=3001

# Client websites (shown on ERP homepage — "Client Projects" section)
NEXT_PUBLIC_CHESS_CLIENT_URL="http://localhost:3002"

# Razorpay Payment Gateway (required for online payments & Simple Invoice)
# 1. Sign up: https://dashboard.razorpay.com/signup
# 2. Switch to Test Mode → Settings → API Keys → Generate Key
# 3. Paste Key ID (rzp_test_...) and Key Secret below, then restart: npm run dev
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_secret_here"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"

# Swagger login (HTTP Basic Auth — not NextAuth)
# Protects interactive docs at /api-docs and the OpenAPI JSON at /api/swagger.
# Set BOTH variables to enable; remove or comment out BOTH to leave docs public.
# In the browser: open e.g. http://localhost:3001/api-docs → dialog asks for user + password.
# From CLI: curl -u YOUR_USER:YOUR_PASS http://localhost:3001/api/swagger
SWAGGER_DOCS_USERNAME="***"
SWAGGER_DOCS_PASSWORD="***"

# Optional: Email Configuration
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER="***@gmail.com"
EMAIL_SERVER_PASSWORD="***"
EMAIL_FROM="noreply@yourdomain.com"
